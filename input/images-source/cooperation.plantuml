@startuml

skinparam svgDimensionStyle false

Title "WP Cooperation"

collections "Legislation" as l
collections "[[index.html Standards]]" as s

actor "WP1" as wp1
collections "WP1\nDeliverable: \nRequirements" as r
participant "[[CodeSystem-DigitalLabelElement.html DLE\nLibary]]" as s2
actor "WP2" as wp2
collections "WP2\nDeliverable:\n[[informationmodel.html Information\n    Model]]" as s3
actor "WP3" as wp3
actor "WP4" as wp4
actor "WP5" as wp5
actor "WP6" as wp6
participant "[[glossary.html Glossary\n     of\n  Terms]]" as g
collections "Other \nDeliverables" as r2

l -> wp1 : import
activate wp1
s -> wp1 : import
s2 -> wp1 : import
activate wp1
wp1 -> s2 : update library
deactivate wp1

wp1 -> r
activate wp1
wp1 -> g
deactivate wp1
deactivate wp1
s2 -> wp2
activate wp2
wp2 -> g
wp2 -> s3
deactivate wp2
r -> wp3
activate wp3
wp3 -> g
wp3 -> r2
deactivate wp3
r -> wp4
activate wp4
wp4 -> g
wp4 -> r2
deactivate wp4

legend
WP x: activities in work package
DLE: "Digital Label Elements"
Artefacts: intermediary list of items needed to create to know for the information model
[[glossary.html Glossary of Terms]]: all WPs should contribute to this list
end legend

@enduml