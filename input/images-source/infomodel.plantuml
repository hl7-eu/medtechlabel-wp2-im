@startuml

' for edits place into comment
' to be included for rendering
skinparam svgDimensionStyle false

title Information Model

'cloud "Accompanying Information" {

    class "Manufacturer" as manu {
        identifier
        name
        address
        contactInfo
    }

    class "(General) \nProduct \n(Information)" as product {
        name
        description
    }

    class "Catalog" as cat {
        catalogNumber
        catalogData
    }

    product "0..*" .right. "0..*" cat : listed in >

    abstract class "Documentation" as documentation {
        language
    }


    class "Instruction \nfor Use (IFU)" as ifu {
        text
    }

    class "electronic \nInstruction \nfor Use (eIFU)" as eifu {
        text
        url
    }

    class "Manual" as manual {
        text
    }

    class "Technical\nDescription" as td {
        text
    }

    product o-- documentation : has >
    documentation o-- web
    documentation "1" o-- "0..1" ifu : > has
    documentation "1" o-- "0..1" eifu : > has
    documentation "1" o-- "0..1" manual : > has
    documentation "1" o-- "0..1" td : > has

    manual -- "0..*" icon : uses >

    class "Icon" as icon {
        symbol
        description
    }

    ifu -- "0..*" icon : > has
    eifu -- "0..*" icon : > has

    ifu <|-- eifu
    
    class "Website" as web {
        url
        content    
    }

    manu -- web : > has
    product -- web
    web -- "0..*" web : > points to

    class "QR Code" as qr {
        content
    }

    manu "1" -right- "0..*" product : > produces



    qr -- "0..1" web : > points to

    class "electronic label" as elabel {

    }

'}



'cloud "Logical Object" {
    class "Product" as prod #ffa {
        identifier[]
        productionDate
    }

    class "Package" as pkg  #ffa {
        packagingSize
        content
    }

    abstract class "Label" as label #ffa {
        description
    }

'}

documentation "1" -- "1" label : > has

label -- qr : > has
label -- "0..*" icon : > has

label <|-- elabel

class "Property" as prop {
    identifier
    description
    value
}

class "Lot" as lot {
    lotNumber
    lotData
}

'cloud "Physical Objects" {
    abstract class "physical Object" as physObj {
        physicalSize
    }

    abstract class "Device" as adev {
        serialNumber
        title
        expiryDate: date

    }

    class "(Specific) \nDevice" as device {
        usageCount
    }

    adev <|-- device

    class "Property Value" as propval {
        value
    }

    device "0..*" .down. "1" lot : produced in >
    device "0..*" .right. "1" prop : has property >
    (device,prop) -- propval

    product .right.. prod

    class "printed Label" as printlbl

    class "Container" as container {
        packagingSize
    }

    class "Accessory" as acc {

    }

    class "Spare Part" as spare {

    }

    class "detachable Component" as comp {

    }

    class "Battery" as batt {

    }

    class "printed \nInstruction \nfor Use (pIFU)" as pifu {
        text
    }


    adev <|-- acc
    adev o-- comp
    comp -up- spare : replaces <

    acc .. device : can support >

    label <|-- printlbl

    physObj <|-- printlbl
    physObj <|-- prod
    physObj <|-- device
    physObj <|-- acc
    physObj <|-- spare
    physObj <|-- pkg
    physObj <|-- container
    physObj <|-- batt
    physObj <|-- pifu

    pkg o-- "0..*" container : > contains (optionally)
    container o-- device : > contains
    container o-- acc : > contains
    pkg o-- "0..*" device : contains
    pkg o-- "0..*" acc : contains
    pkg -- label : > has

'}

ifu <|-down- pifu




@enduml